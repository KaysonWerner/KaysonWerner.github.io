---
import Band from '../components/Band.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Home";
---

<BaseLayout pageTitle={pageTitle}>

  <!-- INTRO TITLE SECTION -->
  <section class="intro intro--title container center">
    <div class="intro__title-wrap">
      <p class="eyebrow">Portfolio</p>
      <h1 class="intro__title">Kayson Werner</h1>
      <p class="intro__tagline">Web Developer • Designer • Problem Solver</p>
    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section id="projects" class="section container center">
    <div class="section__header">
      <h2>Featured Projects</h2>
      <p>A selection of work I’m proud of.</p>
    </div>

    <div class="grid grid--three center">
      <article class="card center">
        <img src="/img/picture_placeholder.png" alt="Project preview" />
        <div class="card__content">
          <h3>Project One</h3>
          <p>A short description explaining the purpose, tools, and outcome.</p>
          <a href="#" class="card__link">View Project →</a>
        </div>
      </article>

      <article class="card center">
        <img src="/img/picture_placeholder.png" alt="Project preview" />
        <div class="card__content">
          <h3>Project Two</h3>
          <p>A short description explaining the purpose, tools, and outcome.</p>
          <a href="#" class="card__link">View Project →</a>
        </div>
      </article>

      <article class="card center">
        <img src="/img/picture_placeholder.png" alt="Project preview" />
        <div class="card__content">
          <h3>Project Three</h3>
          <p>A short description explaining the purpose, tools, and outcome.</p>
          <a href="#" class="card__link">View Project →</a>
        </div>
      </article>
    </div>
  </section>

  <!-- ABOUT BAND SECTION -->
  <section class="center">
    <Band bandTitle="About Me">
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
    </Band>
  </section>

  <!-- CONTACT CTA -->
  <section id="contact" class="cta center">
    <div class="container">
      <h2>Let’s Work Together</h2>
      <p>If you have a project in mind or just want to connect, feel free to reach out.</p>
      <a href="mailto:kaysonwerner9@gmail.com" class="btn">Get In Touch</a>
    </div>
  </section>

</BaseLayout>

